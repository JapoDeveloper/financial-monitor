# === APPLICATION ===
APP_ENV=development
APP_NAME="Financial Platform API"
APP_VERSION=1.0.0
APP_SECRET_KEY=changeme-in-production-use-a-long-random-string
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# === DATABASE (MariaDB) ===
DB_HOST=localhost
DB_PORT=3306
DB_NAME=financial_platform
DB_USER=fp_user
DB_PASSWORD=your_secure_password

# === FINANCIAL PARAMETERS ===
DEFAULT_CURRENCY=USD
DEFAULT_BENCHMARK=SPY
RISK_FREE_RATE=0.043
DEFAULT_HISTORY_YEARS=5

# === YFINANCE ===
YFINANCE_CACHE_TTL=3600
